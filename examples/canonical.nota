;; Canonical NOTA examples for meta-signal-criome.
;;
;; The Configure payload is signal-criome's CriomeDaemonConfiguration,
;; imported rather than duplicated in this contract.

;; Input::Configure
(Configure (/run/criome/criome.sock /var/lib/criome/criome.sema None None Quorum None None None))

;; Input::ObserveParkedAuthorizations
(ObserveParkedAuthorizations ())

;; Input::SubmitAuthorizationApproval
(SubmitAuthorizationApproval (authorization-request-1 Approve))

;; Input::AcceptRootFounding
(AcceptRootFounding (root-anchor-1 (((ThresholdRule (2 [(KeyMember (Host mirror-alpha)) (KeyMember (Host mirror-beta))])) Root) [((Host mirror-alpha) mirror-alpha-master-pubkey) ((Host mirror-beta) mirror-beta-master-pubkey)] CriomeRootFoundingV1 genesis-nonce-1)))

;; Input::InitiateRootFounding — the owner hands the initiator the full cohort
(InitiateRootFounding (((ThresholdRule (2 [(KeyMember (Host mirror-alpha)) (KeyMember (Host mirror-beta))])) Root) [((Host mirror-alpha) mirror-alpha-master-pubkey) ((Host mirror-beta) mirror-beta-master-pubkey)] CriomeRootFoundingV1 genesis-nonce-1))

;; Input::ObserveRootFounding
(ObserveRootFounding ())

;; Output::ConfigurationApplied
(ConfigurationApplied 7)

;; Output::ParkedAuthorizations
(ParkedAuthorizations [(authorization-request-1 (Some (contract-digest-1 (Spirit operation-digest-1 Head) (Spirit operation-digest-1 (((10 20) 1 []) []) [] [] [] []))) None)])

;; Output::AuthorizationApprovalStored
(AuthorizationApprovalStored (authorization-request-1 Approve))

;; Output::ConfigurationRefused
(ConfigurationRefused ManagerAuthorityRequired)

;; Output::OperationUnimplemented
(OperationUnimplemented (Configure DependencyNotReady))

;; Output::RootFoundingConfirmed
(RootFoundingConfirmed (root-anchor-1 ((Host mirror-alpha) (Bls12_381MinPk public-key-1 signature-1))))

;; Output::RootFoundingRefused
(RootFoundingRefused CohortMismatch)

;; Output::RootFoundingObserved — founding state + the pending-founding queue
(RootFoundingObserved (Gathering [(root-anchor-1 (((ThresholdRule (2 [(KeyMember (Host mirror-alpha)) (KeyMember (Host mirror-beta))])) Root) [((Host mirror-alpha) mirror-alpha-master-pubkey) ((Host mirror-beta) mirror-beta-master-pubkey)] CriomeRootFoundingV1 genesis-nonce-1) (Host mirror-alpha))]))
