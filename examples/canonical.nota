;; Canonical NOTA examples for meta-signal-criome.
;;
;; The Configure payload is signal-criome's CriomeDaemonConfiguration,
;; imported rather than duplicated in this contract.

;; Input::Configure
(Configure (/run/criome/criome.sock /var/lib/criome/criome.sema None None Quorum None))

;; Input::ObserveParkedAuthorizations
(ObserveParkedAuthorizations ())

;; Input::SubmitAuthorizationApproval
(SubmitAuthorizationApproval (authorization-request-1 Approve))

;; Input::AcceptRootFounding
(AcceptRootFounding (root-anchor-1 (((Threshold (2 [(KeyMember (Host mirror-alpha)) (KeyMember (Host mirror-beta))])) Root) [((Host mirror-alpha) mirror-alpha-master-pubkey) ((Host mirror-beta) mirror-beta-master-pubkey)] CriomeRootFoundingV1 genesis-nonce-1)))

;; Input::InitiateRootFounding — the owner hands the initiator the full cohort
(InitiateRootFounding (((Threshold (2 [(KeyMember (Host mirror-alpha)) (KeyMember (Host mirror-beta))])) Root) [((Host mirror-alpha) mirror-alpha-master-pubkey) ((Host mirror-beta) mirror-beta-master-pubkey)] CriomeRootFoundingV1 genesis-nonce-1))

;; Input::ObserveRootFounding
(ObserveRootFounding ())

;; Output::Configured
(Configured 7)

;; Output::ParkedAuthorizationSnapshot
(ParkedAuthorizationSnapshot [(authorization-request-1 (Some (contract-digest-1 (Spirit operation-digest-1 Head) (Spirit operation-digest-1 (((10 20) 1 []) []) [] [] [] []))) None)])

;; Output::AuthorizationApprovalRecorded
(AuthorizationApprovalRecorded (authorization-request-1 Approve))

;; Output::ConfigurationRejected
(ConfigurationRejected ManagerAuthorityRequired)

;; Output::RequestUnimplemented
(RequestUnimplemented (Configure DependencyNotReady))

;; Output::RootFoundingAccepted
(RootFoundingAccepted (root-anchor-1 ((Host mirror-alpha) (Bls12_381MinPk public-key-1 signature-1))))

;; Output::RootFoundingRejected
(RootFoundingRejected CohortMismatch)

;; Output::RootFoundingStatus — founding state + the pending-founding queue
(RootFoundingStatus (Gathering [(root-anchor-1 (((Threshold (2 [(KeyMember (Host mirror-alpha)) (KeyMember (Host mirror-beta))])) Root) [((Host mirror-alpha) mirror-alpha-master-pubkey) ((Host mirror-beta) mirror-beta-master-pubkey)] CriomeRootFoundingV1 genesis-nonce-1) (Host mirror-alpha))]))
