;; meta-signal-criome — meta-only authority/configuration wire
;; contract for the criome daemon.
;;
;; Wire-only: emits the rkyv + optional NOTA codec and the
;; signal-frame request/reply envelope. Ordinary trust traffic stays in
;; signal-criome; daemon runtime, sockets, actors, and storage stay in
;; criome.
;;
;; SHARED-TYPE OWNERSHIP. The daemon startup configuration is defined
;; once in the ordinary signal-criome contract and cross-imported here
;; with the single-colon path form signal-criome:lib:TypeName. Startup
;; and meta reconfiguration therefore share one type identity.

{
  CriomeDaemonConfiguration signal-criome:lib:CriomeDaemonConfiguration
  AuthorizationRequestSlot signal-criome:lib:AuthorizationRequestSlot
  ParkedAuthorizationObservation signal-criome:lib:ParkedAuthorizationObservation
  ParkedAuthorizationSnapshot signal-criome:lib:ParkedAuthorizationSnapshot
  InterceptPolicyIdentifier signal-criome:lib:InterceptPolicyIdentifier
  InterceptPolicyProposal signal-criome:lib:InterceptPolicyProposal
  InterceptPolicy signal-criome:lib:InterceptPolicy
  ActiveInterceptPolicies signal-criome:lib:ActiveInterceptPolicies
  InterceptPolicyCancellation signal-criome:lib:InterceptPolicyCancellation
  ParkedRequestQuery signal-criome:lib:ParkedRequestQuery
  ParkedRequestSnapshot signal-criome:lib:ParkedRequestSnapshot
  ParkedRequestAnswer signal-criome:lib:ParkedRequestAnswer
  ParkedRequestResolution signal-criome:lib:ParkedRequestResolution
  RootAnchorDigest signal-criome:lib:RootAnchorDigest
  RootGenesis signal-criome:lib:RootGenesis
  FoundingSignature signal-criome:lib:FoundingSignature
}
[(Configure CriomeDaemonConfiguration)
 (CreateInterceptPolicy InterceptPolicyProposal)
 (ReplaceInterceptPolicy InterceptPolicyProposal)
 (CancelInterceptPolicy InterceptPolicyCancellation)
 (ListInterceptPolicies InterceptPolicyObservation)
 (ObserveInterceptPolicies InterceptPolicyObservation opens InterceptPolicyStream)
 (RetractInterceptPolicyObservation InterceptPolicyStreamToken)
 (FetchParkedRequests ParkedRequestQuery)
 (AnswerParkedRequest ParkedRequestAnswer)
 (ObserveParkedAuthorizations ParkedAuthorizationObservation)
 (SubmitAuthorizationApproval AuthorizationApproval)
 (AcceptRootFounding RootFoundingAcceptance)]
[(Configured Configured)
 (InterceptPolicyCreated InterceptPolicy)
 (InterceptPolicyReplaced InterceptPolicy)
 (InterceptPolicyCancelled InterceptPolicyIdentifier)
 (InterceptPoliciesListed ActiveInterceptPolicies)
 (InterceptPolicyObservationOpened ActiveInterceptPolicies)
 (InterceptPolicyObservationRetracted InterceptPolicyStreamToken)
 (ParkedRequestsFetched ParkedRequestSnapshot)
 (ParkedRequestAnswered ParkedRequestResolution)
 (ParkedAuthorizationSnapshot ParkedAuthorizationSnapshot)
 (AuthorizationApprovalRecorded AuthorizationApprovalRecorded)
 (ConfigurationRejected ConfigurationRejected)
 (RequestUnimplemented RequestUnimplemented)
 (RootFoundingAccepted RootFoundingAccepted)
 (RootFoundingRejected RootFoundingRejected)]
{
  ConfigurationGeneration Integer

  Configured {
    generation.ConfigurationGeneration
  }

  ConfigurationRejectionReason [
    ManagerAuthorityRequired
    MalformedConfiguration
    StoreUnavailable
  ]
  ConfigurationRejected {
    reason.ConfigurationRejectionReason
  }

  AuthorizationApprovalDecision [
    Approve
    Reject
    Defer
  ]
  AuthorizationApproval {
    request_slot.AuthorizationRequestSlot
    decision.AuthorizationApprovalDecision
  }
  AuthorizationApprovalRecorded {
    request_slot.AuthorizationRequestSlot
    decision.AuthorizationApprovalDecision
  }

  ;; ─── Root founding (owner-only, explicit, no auto-approval) ───────
  ;;
  ;; The owner explicitly founds this node's root by accepting the exact
  ;; cohort it was configured to found. `anchor` is the self-certifying
  ;; RootAnchorDigest (blake3(rkyv(RootGenesis))); `cohort` is the full
  ;; RootGenesis so the daemon re-derives and matches the anchor before
  ;; its master key emits an ATTACHED FoundingSignature. There is no
  ;; auto-approval anywhere — acceptance is this explicit owner action.
  RootFoundingAcceptance {
    anchor.RootAnchorDigest
    cohort.RootGenesis
  }

  RootFoundingRejectionReason [
    CohortMismatch
    AlreadyFounded
    ManagerAuthorityRequired
    MalformedGenesis
  ]

  RootFoundingAccepted {
    anchor.RootAnchorDigest
    FoundingSignature
  }

  RootFoundingRejected {
    reason.RootFoundingRejectionReason
  }

  InterceptPolicyObservation { }

  InterceptPolicyChange [
    (Created InterceptPolicy)
    (Replaced InterceptPolicy)
    (Cancelled InterceptPolicyIdentifier)
  ]

  InterceptPolicyStreamToken String
  MetaEvent [
    (InterceptPolicyChanged InterceptPolicyChange belongs InterceptPolicyStream)
  ]
  InterceptPolicyStream (Stream { token.InterceptPolicyStreamToken opened.ActiveInterceptPolicies event.MetaEvent close.InterceptPolicyStreamToken })

  OperationKind [
    Configure
    CreateInterceptPolicy
    ReplaceInterceptPolicy
    CancelInterceptPolicy
    ListInterceptPolicies
    ObserveInterceptPolicies
    RetractInterceptPolicyObservation
    FetchParkedRequests
    AnswerParkedRequest
    ObserveParkedAuthorizations
    SubmitAuthorizationApproval
    AcceptRootFounding
  ]
  UnimplementedReason [NotBuiltYet DependencyNotReady]
  RequestUnimplemented {
    operation.OperationKind
    reason.UnimplementedReason
  }
}
